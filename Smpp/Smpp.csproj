<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net472</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Version>1.2.0</Version>
    <PackageId>SMSGate</PackageId>
    <Title>SMSGate - SMPP client and server for .NET</Title>
    <Authors>Armen Kirakosyan</Authors>
    <Description>A lightweight SMPP 3.4 client and server library for .NET. Send and receive SMS, handle delivery receipts and multipart messages, and test local SMPP sessions with an event-driven API.</Description>
    <PackageTags>smpp;sms;sms-gateway;messaging;telecom;dotnet;csharp;delivery-receipts;multipart;unicode</PackageTags>
    <PackageProjectUrl>https://github.com/kirakosyan/smsgate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kirakosyan/smsgate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2016 Armen Kirakosyan</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>Adds .NET Framework 4.7.2 and later alongside .NET 10, including asynchronous submissions, delivery tracking, diagnostics, cancellation, and TLS. Framework-only compatibility dependencies and portable TLS options preserve the existing .NET 10 API. See https://github.com/kirakosyan/smsgate/blob/v1.2.0/CHANGELOG.md.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Include existing API documentation while undocumented legacy members are completed. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>SMSGate.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.13" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.13" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.13" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../assets/branding/smsgate-icon.png" Pack="true" PackagePath="/icon.png" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>
