<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <PackageId>SMSGate</PackageId>
    <Title>SMSGate - SMPP client and server for .NET</Title>
    <Authors>Armen Kirakosyan</Authors>
    <Description>A lightweight SMPP 3.4 client and server library for .NET. Send and receive SMS, handle delivery receipts and multipart messages, and test local SMPP sessions with an event-driven API.</Description>
    <PackageTags>smpp;sms;sms-gateway;messaging;telecom;dotnet;csharp;delivery-receipts;multipart;unicode</PackageTags>
    <PackageProjectUrl>https://github.com/kirakosyan/smsgate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kirakosyan/smsgate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2016 Armen Kirakosyan</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>First NuGet release for .NET 10, including SMPP client/server sessions, delivery receipts, multipart messaging, and session recovery. See https://github.com/kirakosyan/smsgate/blob/master/CHANGELOG.md.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Include existing API documentation while undocumented legacy members are completed. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../CHANGELOG.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>
